[Unit]
Description=ngmastercabot - worker da fila videos
After=network.target

[Service]
Type=simple
User=SEU_USUARIO
WorkingDirectory=/caminho/para/telegram-assistente
ExecStart=/caminho/para/telegram-assistente/.venv/bin/python -m workers.run_video_worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
